index.html<!DOCTYPE html><html lang="ru"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Кто есть кто в чате</title>
<style>
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);--bg:#fdf6ee;--card:#fff;--tx:#2a2230;--mut:#7a6f82;--line:#eadfd2;--ok:#1f9d63;--bad:#d64550}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#16121d;--card:#221c2e;--tx:#f4eefa;--mut:#a79bb8;--line:#352d46}}
:root[data-theme="dark"]{--bg:#16121d;--card:#221c2e;--tx:#f4eefa;--mut:#a79bb8;--line:#352d46}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--tx);font:16px/1.45 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;min-height:100vh}
#app{max-width:560px;margin:0 auto;padding:18px 16px 40px}
.top{display:flex;justify-content:space-between;font-size:14px;color:var(--mut);margin-bottom:8px;font-weight:600}
.bar{height:8px;background:var(--line);border-radius:9px;overflow:hidden;margin-bottom:16px}
.bar i{display:block;height:100%;background:linear-gradient(90deg,hsl(var(--h,20) 90% 58%),hsl(calc(var(--h,20) + 40) 90% 62%));transition:width .4s}
.hero{height:150px;border-radius:22px;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;background:linear-gradient(135deg,hsl(var(--h) 90% 62%),hsl(calc(var(--h) + 45) 85% 55%));animation:pop .45s}
.hero span{font-size:76px;filter:drop-shadow(0 6px 10px #0003)}
.hero img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.cat{display:inline-block;margin:14px 0 2px;font-size:12px;letter-spacing:.08em;text-transform:uppercase;font-weight:700;color:hsl(var(--h) 80% 50%)}
h1{font-size:30px;margin:10px 0}h2{font-size:21px;line-height:1.3;margin:4px 0 16px}
.opts{display:grid;gap:10px}
.o{display:flex;gap:12px;align-items:center;text-align:left;width:100%;padding:13px 14px;border:2px solid var(--line);background:var(--card);color:var(--tx);border-radius:16px;font:inherit;cursor:pointer;transition:transform .12s,border-color .2s}
.o:hover:not(:disabled){transform:translateY(-2px);border-color:hsl(var(--h) 85% 60%)}
.o b{flex:none;width:30px;height:30px;border-radius:50%;display:grid;place-items:center;background:var(--line);font-size:14px}
.o.ok{border-color:var(--ok);background:color-mix(in srgb,var(--ok) 16%,var(--card))}
.o.bad{border-color:var(--bad);background:color-mix(in srgb,var(--bad) 14%,var(--card));animation:shake .35s}
.o:disabled{cursor:default}.g2{grid-template-columns:1fr 1fr}.g2 .o{flex-direction:column;text-align:center;padding:14px 8px}.av{position:relative;overflow:hidden;width:54px;height:54px;border-radius:50%;display:grid;place-items:center;color:#fff;font-weight:800;font-size:22px;box-shadow:0 4px 10px #0003}.av img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.g2 .o b{display:none}
input{width:100%;padding:14px;border-radius:14px;border:2px solid var(--line);background:var(--card);color:var(--tx);font:inherit;margin-bottom:10px}
input:focus{outline:none;border-color:hsl(var(--h) 85% 60%)}
.btn{width:100%;padding:14px;border:0;border-radius:14px;font:inherit;font-weight:700;color:#fff;cursor:pointer;background:linear-gradient(90deg,hsl(var(--h,20) 90% 55%),hsl(calc(var(--h,20) + 40) 90% 58%))}
.btn.alt{background:var(--card);color:var(--tx);border:2px solid var(--line);margin-top:10px}
.fb{margin-top:16px;padding:14px;border-radius:16px;background:var(--card);border:2px solid var(--line);animation:pop .3s}
.fb .v{font-weight:800;font-size:18px;margin-bottom:4px}.fb p{margin:4px 0 12px;color:var(--mut)}
.c{text-align:center}.big{font-size:90px;margin:10px 0}.sc{font-size:44px;font-weight:800}
.mut{color:var(--mut)}
@keyframes pop{from{transform:scale(.95);opacity:0}to{transform:none;opacity:1}}
@keyframes shake{25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}
</style></head><body><div id="app"></div>
<script>
const AV={"Аня":"#e11d74","Женя":"#8b5cf6","Лаура":"#16a34a","Соня":"#f59e0b","Айдар":"#0ea5e9","Оксана":"#ef4444","Костя":"#14b8a6","Мишка":"#6366f1","Антон":"#64748b","Анна Скуба":"#d946ef","Никита":"#f97316"};
const Q=[
{y:"p",c:"Главная по чату",e:"👑",h:330,q:"Кто пишет в чате больше всех?",o:["Лаура","Аня","Женя","Соня"],a:1,f:"3515 сообщений. Это больше, чем у Жени и Лауры вместе (2583)."},
{y:"n",c:"Главная по чату",e:"🧮",h:20,q:"Какую долю всех сообщений в чате написала одна Аня? Впиши процент, допуск ±4.",n:32,tol:4,f:"Каждое третье сообщение её. Остальные десять человек живут в её треде."},
{y:"p",c:"Кружочки",e:"⭕",h:200,q:"Кто королева кружочков (видеосообщений)?",o:["Лаура","Женя","Аня","Айдар"],a:2,f:"131 кружок. Лаура вторая (53), Женя третья (33). Остальные снимают кружки только под дулом квиза."},
{y:"p",c:"Фотофиниш",e:"📸",h:150,q:"Кто закидал чат фотографиями больше всех?",o:["Аня","Соня","Мишка","Женя"],a:1,f:"Соня 142, Женя 135. Победа с разницей в 7 фото, судьи смотрели повтор."},
{y:"p",c:"Смех",e:"😂",h:50,q:"Кто чаще всех пишет «ахах» и «хаха»?",o:["Аня","Соня","Лаура","Айдар"],a:2,f:"Лаура 67, Соня и Айдар по 60. А Аня при 3515 сообщениях насмеялась всего 11 раз: пишет много, смеётся тихо."},
{y:"p",c:"Шрек-файлы",e:"🟢",h:110,q:"Кто в чате принципиально ненавидит стикер со Шреком?",o:["Костя","Оксана","Айдар","Никита"],a:2,f:"«Как запретить этот стикер», «Ненавижу». И при этом сам третий в чате по стикерам (49). Двойные стандарты."},
{y:"p",c:"Шрек-файлы",e:"🧌",h:90,q:"Кто упоминает Шрека чаще всех?",o:["Лаура","Аня","Костя","Соня"],a:0,f:"Лаура, 32 раза. У Ани 12, у Кости 10. Айдар пытался заблокировать её именно за это."},
{y:"c",c:"Шрек-файлы",e:"🚫",h:350,q:"Айдар предлагал заблокировать в чате Лауру за Шрека. А Костю за что?",o:["За травму","За пиклбол","За караоке","За опоздания на квиз"],a:0,f:"Блокировка не состоялась. Шрек остался в чате навсегда."},
{y:"p",c:"Фирменное",e:"🙏",h:280,q:"Кто чаще всех восклицает «Господи»?",o:["Соня","Аня","Оксана","Лаура"],a:3,f:"Лаура 21, Аня 20. Победа на одно «Господи», как на выборах."},
{y:"t",c:"Тоска по дому",e:"🏙️",h:210,q:"Кто в чате громче всех скучает по Москве? Впиши имя.",k:["аня","анечка","киркорова","анна","anya"],s:"Аня",f:"14 упоминаний. У Лауры 2, у Айдара 1. Остальные, видимо, давно вьетнамцы."},
{y:"p",c:"Спорт",e:"🏓",h:160,q:"Кто чаще всех пишет про пиклбол?",o:["Лаура","Оксана","Женя","Аня"],a:3,f:"44 раза. У Лауры 24, у Жени 17. Классика: «разгон от любой темы до пиклбола 0,3 сек»."},
{y:"p",c:"Нежность",e:"❤️",h:340,q:"Кто главный раздатчик сердечек ❤️🥰😘🫶?",o:["Соня","Женя","Лаура","Аня"],a:3,f:"202 против 25 у следующих. Остальные сердечки экономят на чёрный день."},
{y:"p",c:"Режим сна",e:"🌙",h:250,q:"Кто самый ночной: больше всего сообщений с 00:00 до 06:00?",o:["Аня","Женя","Антон","Соня"],a:2,f:"9% всех сообщений Антона отправлены ночью. У остальных 1–4%. Что-то явно не спится."},
{y:"p",c:"Простыни",e:"📜",h:70,q:"Кто пишет самые длинные сообщения в среднем?",o:["Мишка","Аня","Антон","Никита"],a:0,f:"73 знака в среднем и рекорд 3786. У Ани 30: она берёт количеством, он качеством."},
{y:"p",c:"Япония: кто?",e:"🐋",h:190,q:"Кто в Токио заказал суши с КИТОМ и «чуть-чуть побоялся»?",o:["Женя","Анна Скуба","Аня","Соня"],a:1,f:"Анна Скуба. Перед этим они сходили в кафе с горничными. День прошёл насыщенно."},
{y:"c",c:"Япония: планы Айдара",e:"🎌",h:300,q:"Что Айдар придумал перезапустить на японском после переезда в Японию?",o:["Виагру и Киркорова","Шрека и Леонтьева","Квиз Плиз","Весь пиклбол"],a:0,f:"План рабочий. Он уже бывал в Киото и объявлял всё остальное кринжем."},
{y:"t",c:"Япония: кто?",e:"🗾",h:10,q:"Кто писал в чат «душой с вами в Сибири, а телом здесь, в Японии»? Впиши имя.",k:["женя","евгения","жена"],s:"Женя",f:"Женя в Японии: купила себе сувенир, сходила на онсен-вайб и всё равно следила за квизом."}
];
const $=s=>document.querySelector(s),app=$('#app');
const norm=s=>s.toLowerCase().replace(/ё/g,'е').replace(/[^a-zа-я0-9.,]/g,'');
function lev(a,b){const m=[...Array(b.length+1).keys()];for(let i=1;i<=a.length;i++){let p=m[0];m[0]=i;for(let j=1;j<=b.length;j++){const t=m[j];m[j]=Math.min(m[j]+1,m[j-1]+1,p+(a[i-1]==b[j-1]?0:1));p=t}}return m[b.length]}
const shuf=a=>{a=[...a];for(let i=a.length-1;i>0;i--){const j=Math.random()*(i+1)|0;[a[i],a[j]]=[a[j],a[i]]}return a};
const av=n=>`<span class="av" style="background:${AV[n]||'#888'}">${n[0]}<img src="photos/${n}.jpg" alt="" onerror="this.remove()"></span>`;
let i=0,score=0,right=0,streak=0,best=0;
try{best=+localStorage.getItem('chatquiz2-best')||0}catch(e){}
function start(){i=score=right=streak=0;app.style.cssText='--h:20';app.innerHTML=`<div class="c"><div class="big">🕵️</div><h1>Кто есть кто в чате</h1><p class="mut">${Q.length} вопросов про привычки участников: кто пишет, кто ржёт, кто ненавидит Шрека. Ответы посчитаны по реальной статистике чата. Где нужно вписать ответ, орфографию никто не проверяет.</p>${best?`<p>🏅 Рекорд: ${best} из ${Q.length}</p>`:''}<button class="btn" id="go">Проверить, как хорошо ты знаешь чат</button></div>`;$('#go').onclick=show}
function show(){const q=Q[i];app.style.cssText=`--h:${q.h}`;
const ord=q.o?shuf(q.o.map((t,n)=>n)):0;
app.innerHTML=`<div class="top"><span>Вопрос ${i+1} из ${Q.length}</span><span>⭐ ${score}${streak>1?` · 🔥×${streak}`:''}</span></div><div class="bar"><i style="width:${i/Q.length*100}%"></i></div>
<div class="hero"><span>${q.e}</span></div><div class="cat">${q.c}</div><h2>${q.q}</h2>
${q.o?`<div class="opts${q.y=='p'?' g2':''}">${ord.map((n,k)=>`<button class="o" data-n="${n}"><b>${'ABCD'[k]}</b>${q.y=='p'?av(q.o[n]):''}${q.o[n]}</button>`).join('')}</div>`:`<input id="in" placeholder="${q.y=='n'?'Число':'Имя, орфография не важна'}" autocomplete="off"><button class="btn" id="ans">Ответить</button>`}<div id="fb"></div>`;
if(q.o)document.querySelectorAll('.o').forEach(b=>b.onclick=()=>done(+b.dataset.n==q.a,b));
else{const inp=$('#in');inp.focus();const go=()=>{const raw=inp.value.trim(),a=norm(raw);if(!a)return;
let ok;if(q.y=='n'){const v=parseFloat(raw.replace(',','.'));if(isNaN(v))return;ok=Math.abs(v-q.n)<=q.tol}
else ok=q.k.some(k=>{k=norm(k);return a==k||(k.length>3&&(a.includes(k)||lev(a,k)<=Math.ceil(k.length/4)))||(k.length<=3&&lev(a,k)<=1)});done(ok)};$('#ans').onclick=go;inp.onkeydown=e=>e.key=='Enter'&&go()}}
function done(ok,btn){const q=Q[i];
if(ok){right++;streak++;score+=(q.o?10:15)+Math.min(streak-1,3)*2}else streak=0;
document.querySelectorAll('.o').forEach(b=>{b.disabled=true;if(+b.dataset.n==q.a)b.classList.add('ok');else if(b===btn)b.classList.add('bad')});
const inp=$('#in');if(inp){inp.disabled=true;$('#ans').remove()}
const last=i==Q.length-1,right_=q.s||(q.y=='n'?q.n+'%':q.o[q.a]);
$('#fb').innerHTML=`<div class="fb"><div class="v">${ok?['Верно! 🎉','В точку! 🔥','Знаток чата! 😎'][i%3]:'Мимо 😅'}</div><p>${ok?'':`Правильный ответ: <b>${right_}</b>. `}${q.f}</p><button class="btn" id="nx">${last?'Результат':'Дальше →'}</button></div>`;
$('#nx').onclick=()=>{i++;i<Q.length?show():end()};$('#nx').scrollIntoView({behavior:'smooth',block:'center'})}
function end(){const p=right/Q.length;
const r=p>=.95?['👑','Ты и есть чат (или бот)']:p>=.8?['🏆','Правая рука Ани']:p>=.6?['🎯','Активный участник']:p>=.35?['🤫','Читаешь, но молча']:['🐣','Ты вообще в этом чате?'];
if(right>best){best=right;try{localStorage.setItem('chatquiz2-best',best)}catch(e){}}
app.style.cssText='--h:20';
app.innerHTML=`<div class="c"><div class="big">${r[0]}</div><h1>${r[1]}</h1><div class="sc">${right} из ${Q.length}</div><p class="mut">${score} очков · рекорд ${best} из ${Q.length}</p><button class="btn" id="re">Ещё раз</button><button class="btn alt" id="sh">Скопировать результат</button></div>`;
$('#re').onclick=start;
$('#sh').onclick=async()=>{const t=`Квиз «Кто есть кто в чате»: ${right}/${Q.length}, ${r[0]} ${r[1]}. Побьёшь?`;try{await navigator.clipboard.writeText(t);$('#sh').textContent='Скопировано ✓'}catch(e){$('#sh').textContent=t}}}
start();
</script></body></html>
